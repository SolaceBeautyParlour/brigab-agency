# Postgres — Railway/Render inject this automatically once you attach a database
DATABASE_URL=postgresql://user:password@localhost:5432/brigab

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Paystack — get these from your Paystack dashboard (use TEST keys until launch)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# SMS (Hubtel) — leave blank to log messages to console instead of sending
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=Brigab

# Email (SMTP) — leave blank to log receipts to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@brigab.agency

PORT=4000
NODE_ENV=development
